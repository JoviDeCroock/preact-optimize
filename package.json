{
  "name": "preact-optimize-monorepo",
  "private": true,
  "type": "module",
  "description": "Compile-time JSX optimizations for Preact: static hoisting and signal bindings.",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='packages/*/src/**' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 test/*.test.mjs",
    "fuzz": "FUZZ_SEEDS=2000 SSR_SEEDS=200 node --test test/fuzz.test.mjs test/ssr.test.mjs",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -p .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "bench": "node bench/work.mjs",
    "bench:browser": "node bench/browser/run.mjs",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "changeset publish"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@preact/signals": "^2.11.3",
    "babel-plugin-preact-optimize": "workspace:*",
    "babel7": "npm:@babel/core@^7.29.7",
    "babel7-jsx": "npm:@babel/plugin-transform-react-jsx@^7.29.7",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "playwright-core": "^1.64.1",
    "preact": "^11.0.1",
    "preact-optimize": "workspace:*",
    "preact-render-to-string": "^6.8.1",
    "rolldown": "^1.2.14",
    "rolldown-plugin-preact-optimize": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.13"
  }
}
