{
  "name": "rolldown-plugin-preact-optimize",
  "version": "0.0.1",
  "description": "Rolldown/Vite plugin that hoists static JSX and binds signal reads directly to the DOM in Preact.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "index.d.ts",
    "src"
  ],
  "dependencies": {
    "preact-optimize": "workspace:*",
    "rolldown-string": "^0.3.1"
  },
  "peerDependencies": {
    "rolldown": "^1.0.0",
    "vite": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "license": "MIT",
  "devDependencies": {
    "rolldown": "^1.2.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoviDeCroock/preact-optimize.git",
    "directory": "packages/rolldown"
  }
}
